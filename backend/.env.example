# Bu dosyayı `.env` olarak kopyalayıp değerleri doldurun.
# `.env` git'e girmez (bkz. .gitignore), `.env.example` girer.
# Gerçek anahtarlar koda yazılmaz (RULES.md #17).

# ─── Sunucu ────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
RELOAD=true

# ─── Veritabanı ────────────────────────────────────────────────────────────
# Yerel geliştirme (varsayılan):
DATABASE_URL=sqlite:///./storage/database/app.db
#
# ÜRETİM (Render): MUTLAKA kalıcı bir Postgres verin. ENVIRONMENT=production
# iken SQLite adresi verilirse uygulama AÇILMAZ: Render'ın diski kalıcı
# olmadığı için her dağıtımda/uyanışta tüm kullanıcılar, stratejiler ve işlem
# günlüğü silinirdi (bkz. config.assert_production_ready).
# DATABASE_URL=postgresql://kullanici:parola@host:5432/veritabani
# (Render adresi `postgres://` ile başlarsa kod bunu otomatik düzeltir.)

# ─── Kimlik Doğrulama ──────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ÜRETİMDE ZORUNLU. ENVIRONMENT=production iken bu değer boş ya da depodaki
# geliştirme anahtarıysa uygulama AÇILMAZ (bkz. config.assert_production_ready) —
# aksi halde herkesin görebildiği bir anahtarla token imzalanır ve isteyen
# kendi kimliğiyle token üretip tüm kullanıcı verisine erişebilir.
# Üretmek için:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
FRONTEND_URL=http://localhost:5173

# Geliştirici test girişi (opsiyonel, varsayılan: kapalı).
# Doldurulursa POST /api/auth/google isteğinde credential bu değere birebir
# eşit olduğunda DEV_LOGIN_EMAIL hesabıyla giriş yapılır; Google doğrulamasını
# atlayan TEK yoldur. Boş bırakın; yalnızca kendi test hesabınız için,
# rastgele üretilmiş uzun bir gizli değerle (örn. secrets.token_urlsafe(32))
# doldurun ve kimseyle paylaşmayın.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DEV_LOGIN_TOKEN=
DEV_LOGIN_EMAIL=demo.trader@example.com

# ─── Admin Yetkisi ─────────────────────────────────────────────────────────
# /api/admin/* uçlarına erişebilecek e-postalar (virgülle ayrılır).
# Boş bırakılırsa hiç kimse admin sayılmaz (güvenli varsayılan).
ADMIN_EMAILS=

# ─── Twelve Data (opsiyonel, ikincil intraday kaynağı) ─────────────────────
# Boş bırakılırsa nasdaq/bist/forex sağlayıcıları yalnızca Yahoo Finance'e
# döner (mevcut davranış). Doldurulursa Yahoo'nun kırptığı intraday geçmişi
# (1h için 730 gün, 15dk/5dk için 58 gün, 1dk için 6 gün) tamamlamak için
# devreye girer. Ücretsiz plan, kart istemeden twelvedata.com/pricing'den
# alınır (800 istek/gün, 8 kredi/dk — kod bu tavana göre kendini yavaşlatır).
TWELVE_API_KEY=

# ─── Performans Ölçümü (geliştirme aracı) ──────────────────────────────────
# Her isteğin süresini, hangi faz olduğunu ("ilk pencere" / "geçmiş
# derinleştirme" / "strateji çalıştırma") ve süreyi neyin harcadığını
# (önbellek mi, sağlayıcıya çıkmak mı) terminale ve bir JSONL dosyasına yazar.
# Canlı izlemek için ayrı bir terminalde:  python scripts/perf_log.py
#
# Boş bırakılırsa otomatik: üretim DIŞINDA açık, üretimde kapalı.
PERF_LOG=
# Boş bırakılırsa storage/logs/perf.jsonl
PERF_LOG_PATH=
# Dosya bu boyutu aşınca devredilir (mevcut dosya .1 olur, yenisi sıfırdan
# başlar). Tek yedek tutulur, yani disk tavanı kabaca bunun iki katı.
PERF_LOG_MAX_MB=5

# ─── Hız Sınırı ────────────────────────────────────────────────────────────
# Piyasa verisi uçları için kullanıcı başına dakikalık istek sınırı. Uçlar
# sağlayıcıya (Yahoo/Binance) proxy yaptığı için sınırsız kullanım sunucu
# IP'sinin engellenmesine yol açabiliyor.
MARKET_RATE_LIMIT_PER_MINUTE=120

# ─── Veri Saklama Limitleri (bar sayısı, RULES.md #24-27) ──────────────────
# Limit ZAMAN DİLİMİ BAŞINA. Eskiden 1dk/5dk/15dk aynı limiti paylaşıyordu ve
# 15dk'da bu ≈2,9 yıl demekti — kural "son birkaç ay" diyor.
# Bu değerler diskte ne kadar geçmiş tutulacağını VE testlerin ne kadar
# geriye gidebileceğini belirler; daha derin intraday testi gerekiyorsa
# yükseltilebilir.
RETENTION_1M=100000    # ≈ 69 gün
RETENTION_5M=50000     # ≈ 174 gün
RETENTION_15M=20000    # ≈ 208 gün
RETENTION_1H=20000     # ≈ 2,3 yıl
RETENTION_4H=6000      # ≈ 2,7 yıl
RETENTION_1D=5000      # ≈ 13,7 yıl (1w/1mo de bunu kullanır ≈ tüm geçmiş)

# Süreç içi (RAM) mum önbelleğinin azami toplam satır sayısı. Sınır aşılınca
# en az kullanılan çerçeveler düşürülür. 1.000.000 satır ≈ 56 MB.
MEM_CACHE_MAX_ROWS=1000000

# Gece yarısı piyasa verisi güncelleme işi. Birden fazla uvicorn worker'a
# geçilirse yalnızca birinde açık bırakılmalı.
ENABLE_SCHEDULER=true

# ─── Hata İzleme (Sentry) ──────────────────────────────────────────────────
# Boş bırakılırsa tamamen kapalıdır (güvenli varsayılan) — yerel geliştirmede
# hiçbir olay gönderilmez. DSN, sentry.io'da kendi hesabınızla oluşturacağınız
# projeden alınır (bu adım hesap açmayı gerektirdiği için elle yapılmalı).
# Render'da (Environment sekmesi) SENTRY_DSN'i doldurun; ENVIRONMENT'ı da
# "production" yapın ki olaylar yerel/test ortamıyla karışmasın.
SENTRY_DSN=
ENVIRONMENT=development
# Performans (trace) örnekleme oranı, 0.0-1.0. Düşük tutulursa ücretsiz/düşük
# plan kotası hata yakalamadan önce tükenmez; hata raporlama bundan etkilenmez.
SENTRY_TRACES_SAMPLE_RATE=0.1
