# Bu dosyayı `.env` olarak kopyalayıp değerleri doldurun.
# `.env` git'e girmez (bkz. .gitignore), `.env.example` girer.
# Gerçek anahtarlar koda yazılmaz (RULES.md #17).

# ─── Sunucu ────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
RELOAD=true

# ─── Veritabanı ────────────────────────────────────────────────────────────
# Yerel geliştirme (varsayılan):
DATABASE_URL=sqlite:///./storage/database/app.db
#
# ÜRETİM (Render): MUTLAKA kalıcı bir Postgres verin. Ayarlanmazsa uygulama
# SQLite dosyasına düşer; Render'ın diski kalıcı olmadığı için her yeniden
# dağıtımda/uykudan uyanışta tüm kullanıcılar ve stratejiler silinir.
# DATABASE_URL=postgresql://kullanici:parola@host:5432/veritabani
# (Render adresi `postgres://` ile başlarsa kod bunu otomatik düzeltir.)

# ─── Kimlik Doğrulama ──────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Üretimde MUTLAKA değiştirin. Üretmek için:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
FRONTEND_URL=http://localhost:5173

# Geliştirici test girişi (opsiyonel, varsayılan: kapalı).
# Doldurulursa POST /api/auth/google isteğinde credential bu değere birebir
# eşit olduğunda DEV_LOGIN_EMAIL hesabıyla giriş yapılır; Google doğrulamasını
# atlayan TEK yoldur. Boş bırakın; yalnızca kendi test hesabınız için,
# rastgele üretilmiş uzun bir gizli değerle (örn. secrets.token_urlsafe(32))
# doldurun ve kimseyle paylaşmayın.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DEV_LOGIN_TOKEN=
DEV_LOGIN_EMAIL=demo.trader@example.com

# ─── Admin Yetkisi ─────────────────────────────────────────────────────────
# /api/admin/* uçlarına erişebilecek e-postalar (virgülle ayrılır).
# Boş bırakılırsa hiç kimse admin sayılmaz (güvenli varsayılan).
ADMIN_EMAILS=

# ─── Veri Saklama Limitleri (bar sayısı, RULES.md #24-27) ──────────────────
RETENTION_1M=100000
RETENTION_1H=20000
RETENTION_1D=5000

# ─── Hata İzleme (Sentry) ──────────────────────────────────────────────────
# Boş bırakılırsa tamamen kapalıdır (güvenli varsayılan) — yerel geliştirmede
# hiçbir olay gönderilmez. DSN, sentry.io'da kendi hesabınızla oluşturacağınız
# projeden alınır (bu adım hesap açmayı gerektirdiği için elle yapılmalı).
# Render'da (Environment sekmesi) SENTRY_DSN'i doldurun; ENVIRONMENT'ı da
# "production" yapın ki olaylar yerel/test ortamıyla karışmasın.
SENTRY_DSN=
ENVIRONMENT=development
# Performans (trace) örnekleme oranı, 0.0-1.0. Düşük tutulursa ücretsiz/düşük
# plan kotası hata yakalamadan önce tükenmez; hata raporlama bundan etkilenmez.
SENTRY_TRACES_SAMPLE_RATE=0.1
